# Copy to .env. These match docker-compose.yml.
PGHOST=localhost
PGPORT=5434
PGDATABASE=feerecon
PGUSER=feerecon
PGPASSWORD=feerecon

# Only needed for `feerecon extract` (reading a fee schedule document with a model on Groq).
# A key from the free tier at console.groq.com is enough.
GROQ_API_KEY=
# The Groq model to use, one that supports tool use. Required for extract, there is no default.
FEERECON_MODEL=
